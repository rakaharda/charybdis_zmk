#include <dt-bindings/zmk/mouse.h>
#include <behaviors/mouse_keys.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    /* input config for mouse move mode */

    trackball_listener {
        compatible = "zmk,input-behavior-listener";
        device = <&vtrackball>;
        layers = <0 3>;
        evt-type = <INPUT_EV_REL>;
        x-input-code = <INPUT_REL_X>;
        y-input-code = <INPUT_REL_Y>;
        scale-multiplier = <1>;
        scale-divisor = <2>;

        // bindings = <&ib_toggle_layer 7>;
    };

    /* input config for mouse scroll mode */

    trackball_scroll_listener {
        compatible = "zmk,input-behavior-listener";
        device = <&vtrackball>;
        layers = <1 2 4 5 6>;
        evt-type = <INPUT_EV_REL>;
        x-input-code = <INPUT_REL_MISC>;
        y-input-code = <INPUT_REL_WHEEL>;
        y-invert;
        bindings = <&ib_wheel_scaler 1 28>;
    };

    /* input config for snipe mode */

    trackball_snipe_listener {
        compatible = "zmk,input-behavior-listener";
        device = <&vtrackball>;
        layers = <7>;
        evt-type = <INPUT_EV_REL>;
        x-input-code = <INPUT_REL_X>;
        y-input-code = <INPUT_REL_Y>;
        scale-multiplier = <1>;
        scale-divisor = <4>;
    };

    /* define a resolution down scaler only for INPUT_REL_WHEEL */

    ib_wheel_scaler: ib_wheel_scaler {
        compatible = "zmk,input-behavior-scaler";
        #binding-cells = <2>;
        evt-type = <INPUT_EV_REL>;
        input-code = <INPUT_REL_WHEEL>;
    };

    /* adjust cooldown waiting period for mouse key layer after activated */

    ib_toggle_layer: ib_toggle_layer {
        compatible = "zmk,input-behavior-tog-layer";
        #binding-cells = <1>;
        time-to-live-ms = <750>;
    };

    combos {
        compatible = "zmk,combos";

        to-WIN {
            bindings = <&to 0>;
            key-positions = <50 51>;
        };

        to-TYPING {
            bindings = <&to 3>;
            key-positions = <49 52>;
        };

        to-FN {
            bindings = <&to 8>;
            key-positions = <41 42>;
        };

        caps_word {
            bindings = <&caps_word>;
            key-positions = <31 28>;
        };

        rh_leftClick {
            bindings = <&mkp LCLK>;
            key-positions = <43 44>;
        };

        rh_rightClick {
            bindings = <&mkp RCLK>;
            key-positions = <44 45>;
        };

        rh_middleClick {
            bindings = <&mkp MCLK>;
            key-positions = <44 45 43>;
        };

        lh_leftClick {
            bindings = <&mkp LCLK>;
            key-positions = <40 39>;
        };

        lh_rightClick {
            bindings = <&mkp RCLK>;
            key-positions = <38 39>;
        };

        lh_middleClick {
            bindings = <&mkp MCLK>;
            key-positions = <38 39 40>;
        };

        CAPZ {
            bindings = <&kp CAPSLOCK>;
            key-positions = <24 25>;
        };

        to_SCROLL {
            bindings = <&mo 6>;
            key-positions = <45 46>;
        };

        studio_unlock {
            bindings = <&studio_unlock>;
            key-positions = <0 1>;
        };

        to-GAMING {
            bindings = <&to 9>;
            key-positions = <48 52>;
        };
    };

    behaviors {
        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <190>;
            quick-tap-ms = <175>;
            flavor = "balanced";
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41 48 49 50 53 54 51 52 55>;
            hold-trigger-on-release;
        };

        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <190>;
            quick-tap-ms = <175>;
            flavor = "balanced";
            hold-trigger-key-positions = <48 49 50 53 54 51 52 55 6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 42 43 44 45 46 47 51 52>;
            hold-trigger-on-release;
        };

        lmkp: lmkp {
            compatible = "zmk,behavior-hold-tap";
            label = "LMPK";
            flavor = "tap-preferred";
            bindings = <&mo>, <&mkp>;

            #binding-cells = <2>;
            tapping-term-ms = <190>;
            quick-tap-ms = <175>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_win_layer {
            bindings = <
&kp ESCAPE      &kp N1  &kp N2  &kp N3        &kp N4        &kp N5       &kp N6     &kp N7         &kp N8     &kp N9   &kp N0     &kp MINUS
&kp TAB         &kp Q   &kp W   &kp E         &kp R         &kp T        &kp Y      &kp U          &kp I      &kp O    &kp P      &kp LBKT
&kp LEFT_SHIFT  &kp A   &kp S   &kp D         &kp F         &kp G        &kp H      &kp J          &kp K      &kp L    &kp SEMI   &kp APOSTROPHE
&kp LCTRL       &kp Z   &kp X   &kp C         &kp V         &kp B        &kp N      &kp M          &kp COMMA  &kp DOT  &kp SLASH  &kp RIGHT_BRACKET
                                &kp LEFT_ALT  &kp SPACE     &mo 1        &kp ENTER  &kp BACKSPACE
                                              &kp LEFT_GUI  &mkp LCLK    &mo 2
            >;

            label = "QWERTY";
        };

        win_raise_layer {
            bindings = <
&trans     &trans  &trans           &trans            &trans                 &trans    &trans           &trans           &trans           &trans           &trans        &trans
&kp GRAVE  &kp F1  &kp F2           &kp F3            &kp F4                 &kp F5    &trans           &kp KP_NUMBER_7  &kp KP_N8        &kp KP_NUMBER_9  &kp KP_MINUS  &trans
&trans     &trans  &kp PRINTSCREEN  &kp C_PLAY_PAUSE  &mt C_PREVIOUS C_NEXT  &trans    &kp KP_DOT       &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_PLUS   &trans
&trans     &trans  &trans           &trans            &trans                 &trans    &kp KP_NUMBER_0  &kp KP_N1        &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_ENTER  &trans
                                    &trans            &trans                 &trans    &trans           &trans
                                                      &trans                 &trans    &trans
            >;

            label = "RAISE ";
        };

        win_lower_layer {
            bindings = <
&trans  &trans    &trans         &trans          &trans            &trans        &trans    &trans                  &trans        &trans             &trans   &trans
&trans  &kt F1    &kp F2         &kp F3          &kp F4            &kp F5        &kp F6    &kp F7                  &kp F8        &kp F9             &kp F10  &kp F11
&trans  &kp HOME  &kp PAGE_UP    &kp C_PREVIOUS  &kp C_PLAY_PAUSE  &kp C_NEXT    &kp HOME  &kp LC(LS(LEFT_ARROW))  &kp UP_ARROW  &kp LC(LS(RIGHT))  &kp END  &kp F12
&trans  &kp END   &kp PAGE_DOWN  &trans          &trans            &trans        &kp DEL   &kp LEFT_ARROW          &kp DOWN      &kp RIGHT          &trans   &studio_unlock
                                 &trans          &trans            &trans        &trans    &kp DEL
                                                 &trans            &trans        &trans
            >;

            label = "NAV-FUN";
        };

        typing_layer {
            bindings = <
&trans  &trans           &trans           &trans        &trans             &trans    &trans       &trans             &trans        &trans            &trans                    &trans
&trans  &trans           &trans           &trans        &trans             &trans    &trans       &trans             &trans        &trans            &trans                    &trans
&trans  &hml LEFT_GUI A  &hml LEFT_ALT S  &hml LCTRL D  &hml LEFT_SHIFT F  &trans    &trans       &hmr LEFT_SHIFT J  &hmr RCTRL K  &hmr RIGHT_ALT L  &hmr RIGHT_GUI SEMICOLON  &trans
&trans  &trans           &trans           &trans        &trans             &trans    &trans       &trans             &trans        &trans            &trans                    &trans
                                          &trans        &lt 4 SPACE        &trans    &lt 5 ENTER  &trans
                                                        &mo 4              &trans    &mo 5
            >;
        };

        typing_raise_layer {
            bindings = <
&trans  &kp F1           &kp F2                &kp F3     &kp F4                 &kp F5       &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp GRAVE        &kp LEFT_BRACE        &kp ASTRK  &kp RIGHT_BRACE        &kp PLUS     &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp MINUS        &kp LEFT_PARENTHESIS  &kp EQUAL  &kp RIGHT_PARENTHESIS  &kp UNDER    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp EXCLAMATION  &kp LBKT              &kp AMPS   &kp RBKT               &kp HASH     &trans  &trans  &trans  &trans  &trans  &trans
                                               &trans     &trans                 &trans       &trans  &trans
                                                          &trans                 &trans       &trans
            >;
        };

        typing_lower_layer {
            label = "TYPING_LOWER";
            bindings = <
&trans  &trans    &trans         &trans          &trans            &trans        &trans    &trans              &trans        &trans               &trans   &trans
&trans  &kt F1    &kp F2         &kp F3          &kp F4            &kp F5        &kp F6    &kp F7              &kp F8        &kp F9               &kp F10  &kp F11
&trans  &kp HOME  &kp PAGE_UP    &kp C_PREVIOUS  &kp C_PLAY_PAUSE  &kp C_NEXT    &kp HOME  &kp LC(LEFT_ARROW)  &kp UP_ARROW  &kp LC(RIGHT_ARROW)  &kp END  &kp F12
&trans  &kp END   &kp PAGE_DOWN  &trans          &trans            &trans        &kp DEL   &kp LEFT_ARROW      &kp DOWN      &kp RIGHT            &trans   &studio_unlock
                                 &trans          &trans            &trans        &trans    &kp DEL
                                                 &trans            &trans        &trans
            >;
        };

        scroll_layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans
                                &trans  &trans    &trans
            >;

            label = "SCROLL";
        };

        sniper_layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans
                                &trans  &trans    &trans
            >;

            label = "SNIPER";
        };

        keeb_pref_layer {
            label = "FN";
            bindings = <
&ext_power EP_TOG  &trans        &trans        &trans        &trans        &trans          &trans  &trans  &trans  &trans  &trans  &trans
&trans             &trans        &trans        &trans        &trans        &trans          &trans  &trans  &trans  &trans  &trans  &trans
&bt BT_CLR         &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &trans  &trans  &trans  &trans  &trans  &trans
&trans             &trans        &trans        &trans        &trans        &trans          &trans  &trans  &trans  &trans  &trans  &trans
                                               &trans        &trans        &trans          &trans  &trans
                                                             &trans        &trans          &trans
            >;
        };

        gaming_layer {
            bindings = <
&kp F1  &kp ESC    &kp N1  &kp N2  &kp N3  &kp N4       &trans     &trans  &trans  &trans  &trans  &trans
&kp F2  &kp TAB    &kp Q   &kp W   &kp E   &kp R        &trans     &trans  &trans  &trans  &trans  &trans
&kp F3  &kp LSHFT  &kp A   &kp S   &kp D   &kp F        &trans     &trans  &trans  &trans  &trans  &trans
&kp F4  &kp LCTRL  &kp Z   &kp X   &kp C   &kp V        &trans     &trans  &trans  &trans  &trans  &trans
                           &trans  &trans  &kp SPACE    &mkp MCLK  &trans
                                   &mo 0   &mkp LCLK    &mkp RCLK
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        scroll_on_raise {
            if-layers = <1>;
            then-layer = <6>;
        };
    };
};
